# Salin file ini jadi ".env" kalau perlu.
# Nggak wajib diisi — kalau kosong, bot bakal pakai nilai dari config/settings.js.

# Nomor WA yang mau ditautkan lewat kode pairing.
# Formatnya: kode negara + nomor, tanpa "+" dan tanpa spasi. Contoh: 6281234567890
# Wajib diisi kalau kamu jalanin bot di panel hosting (Pterodactyl dkk)
# yang nggak bisa nerima input langsung dari terminal.
PAIRING_NUMBER=

# ── Konfigurasi download (opsional — SEMUA baris di bawah ini boleh dikosongkan) ──
# Baris-baris ini adalah environment variable, BUKAN perintah yang dijalankan di
# terminal/panel. Cara isinya: taruh di file .env ini, atau lewat menu
# "Environment Variables" di panel hosting kamu (Pterodactyl dkk).
#
# Sejak lib/ytdlp.js ada, bot bakal cari/unduh yt-dlp SENDIRI secara otomatis saat
# pertama kali start (lihat log "Menyiapkan Dependensi Download"). Baris SWIFTVIANA_YTDLP_PATH
# di bawah cuma perlu diisi kalau kamu mau MEMAKSA bot pakai binary yt-dlp yang sudah
# kamu pasang sendiri di lokasi custom — kalau tidak yakin, biarkan kosong saja.
# SWIFTVIANA_YTDLP_PATH=/path/ke/yt-dlp
# SWIFTVIANA_YTDLP_TIMEOUT_MS=120000

# Resolver cobalt eksternal (opsional) buat plugin .play — kalau diisi, dicoba sebagai
# salah satu kandidat sumber sebelum fallback ke scraping YouTube langsung.
# SWIFTVIANA_COBALT_URL=
# SWIFTVIANA_DOWNLOADER_KEY=

# Override API key cadangan (dipakai HANYA kalau yt-dlp gagal) untuk masing-masing
# fitur download. Nggak wajib diisi — tiap plugin sudah punya key default bawaan.
# SWIFTVIANA_TIKTOK_KEY=
# SWIFTVIANA_FACEBOOK_KEY=
# SWIFTVIANA_YTMP3_KEY=

